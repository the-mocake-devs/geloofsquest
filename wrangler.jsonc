{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "geloofsquest",
  "workers_dev": true,
  "compatibility_date": "2026-11-26",
  "main": "worker/index.js",
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page",
    "base_path": "/quest"
  },
  "routes": [
    { "pattern": "sjbijbel.app/quest", "zone_name": "sjbijbel.app" },
    { "pattern": "sjbijbel.app/quest/*", "zone_name": "sjbijbel.app" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "geloofsquest",
      "database_id": "4a55ef0d-2546-42aa-8a02-43b474de6d6f"
    }
  ],
  "vars": {
    "MICROSOFT_CLIENT_ID": "aca053a9-6d35-445f-b0fd-0d0502275ad6",
    "MICROSOFT_TENANT": "common",
    "ADMIN_EMAILS": "anik.vandenheuvel@sjbmalle.be,vandenbroeckthijs2013@gmail.com,pimwillekens@gmail.com",
    "OPADMIN_EMAILS": "vandenbroeckthijs2013@gmail.com,pimwillekens@gmail.com"
  }
}
